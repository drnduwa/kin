rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- FONCTIONS DE SÉCURITÉ ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'drnduwa@gmail.com' || 
        request.auth.token.email == 'contact.congonamotema@gmail.com'
      );
    }

    // --- RÈGLES DES COLLECTIONS ---

    /** Profils utilisateurs */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Autorise la lecture pour la diffusion e-mail
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /star_transactions/{id} { allow read, create: if isOwner(userId) || isAdmin(); }
      match /transport_subscriptions/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /pushSubscriptions/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /fcmTokens/{id} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    /** Chat Communautaire (Radio Trottoir) */
    match /community_chat/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // Permet les "likes" par tout membre connecté
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    /** Rapports de route et dangers (Hazard Map) */
    match /road_condition_reports/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn(); 
      allow delete: if isAdmin();
    }

    /** Événements signalés (Incidents du flux principal) */
    match /events/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      match /comments/{commentId} { allow read, create: if isSignedIn(); }
    }

    /** Vidéos communautaires */
    match /videos/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId);
      match /comments/{commentId} { allow read, create: if isSignedIn(); }
    }

    /** Rapports de trafic quotidiens (Audit) */
    match /daily_traffic_reports/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /** Notifications système */
    match /notifications/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    /** Analyses Stratégiques IA */
    match /traffic_insights/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    /** Services Business */
    match /logements/{id} { allow read: if true; allow write: if isAdmin(); }
    match /logement_applications/{id} { allow read: if isAdmin(); allow create: if isSignedIn(); }
    match /tourism_events/{id} { allow read: if true; allow write: if isAdmin(); }
    match /tourism_bookings/{id} { allow read: if isAdmin(); allow create: if isSignedIn(); }
    match /car_bookings/{id} { allow read: if isAdmin(); allow create: if isSignedIn(); }
    match /inquiries/{id} { allow read: if isAdmin(); allow create: if isSignedIn(); }
    match /police_reports/{id} { allow read: if true; allow create: if isSignedIn(); allow delete: if isAdmin(); }
    match /presence/{userId} { allow get, list: if isSignedIn(); allow write: if isOwner(userId); }
    match /mail/{mailId} { allow create: if isSignedIn(); allow read, update, delete: if isAdmin(); }
    match /app_settings/{document} { allow read: if true; allow write: if isAdmin(); }
  }
}