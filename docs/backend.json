{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Profil utilisateur et balance de Stars.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "photoURL": { "type": "string" },
        "currentStarsBalance": { "type": "number" },
        "totalStarsEarned": { "type": "number" },
        "totalStarsPurchased": { "type": "number" },
        "totalStarsUsed": { "type": "number" },
        "isBlocked": { "type": "boolean" },
        "isCashSubscribed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "currentStarsBalance"]
    },
    "CommunityMessage": {
      "title": "CommunityMessage",
      "type": "object",
      "description": "Message partagé dans le salon communautaire.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video", "audio"] },
        "locationName": { "type": "string" },
        "alertType": { "type": "string", "enum": ["travaux", "police", "embouteillage"] },
        "likes": { "type": "number" },
        "commentCount": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "timestamp"]
    },
    "ChatComment": {
      "title": "ChatComment",
      "type": "object",
      "description": "Commentaire sous un message du chat.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "text", "timestamp"]
    },
    "RoadConditionReport": {
      "title": "RoadConditionReport",
      "type": "object",
      "description": "Signalement d'incident ou de danger sur la route.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["pothole", "blockage", "police", "damaged_road"] },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "coords": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "votes": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "coords", "createdAt"]
    },
    "EventReport": {
      "title": "EventReport",
      "type": "object",
      "description": "Incident de trafic signalé par la communauté.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "user": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "picture": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "location", "severity", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com", "apple.com"]
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/backend/entities/User" }, "description": "Profils utilisateurs." },
    "/community_chat/{messageId}": { "schema": { "$ref": "#/backend/entities/CommunityMessage" }, "description": "Messages Radio Trottoir." },
    "/community_chat/{messageId}/comments/{commentId}": { "schema": { "$ref": "#/backend/entities/ChatComment" }, "description": "Commentaires du chat." },
    "/road_condition_reports/{reportId}": { "schema": { "$ref": "#/backend/entities/RoadConditionReport" }, "description": "Signalements de dangers." },
    "/events/{eventId}": { "schema": { "$ref": "#/backend/entities/EventReport" }, "description": "Incidents de trafic communautaires." }
  }
}