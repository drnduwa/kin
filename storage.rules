rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Lecture publique pour tous les contenus communautaires
    match /{allPaths=**} {
      allow read: if true;
    }

    // --- RÈGLES D'ÉCRITURE PROFESSIONNELLES ---
    
    // Autorisation universelle par dossier utilisateur
    // folder peut être : chat, reports, hazards, videos, avatars
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'drnduwa@gmail.com');
    }

    // Services Administratifs (Logements, Tourisme, Adverts)
    match /logements/{logementId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.token.email == 'drnduwa@gmail.com';
    }
    
    match /tourism/{eventId}/{allPaths=**} {
      allow write: if request.auth != null && (request.auth.token.email == 'drnduwa@gmail.com' || request.auth.token.email == 'contact.congonamotema@gmail.com');
    }

    match /videos/{userId}/adverts/{allPaths=**} {
      allow write: if request.auth != null && request.auth.token.email == 'drnduwa@gmail.com';
    }

    // Règle de secours globale pour les utilisateurs identifiés
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}