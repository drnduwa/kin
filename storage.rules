rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Règles pour les médias du chat communautaire
    match /chat/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Règles pour les signalements de trafic et dangers
    match /reports/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /hazards/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Règles pour les vidéos communautaires
    match /videos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Règles pour les avatars utilisateurs
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Dossiers de services (logements, tourisme) - Droits admin
    match /logements/{logementId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'drnduwa@gmail.com';
    }
    
    match /tourism/{eventId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == 'drnduwa@gmail.com' || request.auth.token.email == 'contact.congonamotema@gmail.com');
    }

    // Règle de secours (Fallback)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}