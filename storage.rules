rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Lecture publique pour tous les contenus communautaires
    match /{allPaths=**} {
      allow read: if true;
    }

    // --- RÈGLES D'ÉCRITURE ---

    // Règle universelle pour les dossiers utilisateurs :
    // Autorise l'écriture si l'utilisateur est authentifié et que le dossier {userId} correspond à son UID.
    // Couvre : chat, reports, hazards, videos, avatars.
    match /{folder}/{userId}/{allPaths=**} {
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == 'drnduwa@gmail.com'
      );
    }
    
    // Règle de secours pour les avatars (si pas de sous-chemin)
    match /avatars/{userId} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Services Administratifs (Logements, Tourisme)
    match /logements/{logementId}/{allPaths=**} {
      allow write: if request.auth != null && (
        request.auth.token.email == 'drnduwa@gmail.com'
      );
    }
    
    match /tourism/{eventId}/{allPaths=**} {
      allow write: if request.auth != null && (
        request.auth.token.email == 'drnduwa@gmail.com' || 
        request.auth.token.email == 'contact.congonamotema@gmail.com'
      );
    }

    // Autorisation globale pour tout utilisateur identifié (sécurité supplémentaire)
    match /{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}